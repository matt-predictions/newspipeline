#!/usr/bin/env bash
# Run both judges against the latest event folder under output/ (or a
# specific folder passed as $1). Prints a small score table.
set -euo pipefail
cd "$(dirname "$0")"
if [ ! -d .venv ]; then
  python3 -m venv .venv
fi
# shellcheck disable=SC1091
source .venv/bin/activate
pip install -q -r requirements.txt
target="${1:-}"
exec python -m evals.run "$target"
