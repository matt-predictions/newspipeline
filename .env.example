# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit it.
#
# You need AT LEAST ONE of the two keys below; both is best.
#   both          -> full pipeline (OpenAI: brief+hero+sora, Anthropic: panel+proposer)
#   openai only   -> panel + proposer route through OpenAI; full pipeline
#   anthropic only-> brief routes through Anthropic; no hero, no sora

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (defaults shown):
# OPENAI_MODEL_TOP=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-1
# ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_OPUS=claude-opus-4-7

# Spend cap (cents/day across all LLM + image calls):
# MAX_SPEND_CENTS_PER_DAY=1500

# How many stories to run concurrently with `run -n N` (rate-limit guard):
# MAX_PARALLEL_STORIES=3

# Sora 2 video rendering (off by default — burns money fast):
ENABLE_SORA_RENDER=false
# SORA_MODEL_ID=sora-2          # or sora-2-pro
# SORA_MAX_WAIT_S=600           # poll budget per video (10 min)
# SORA_POLL_INTERVAL_S=10
